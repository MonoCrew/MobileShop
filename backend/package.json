{
  "name": "pos-backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
    "flush": "node scripts/flushDB.js",
    "flush:force": "node scripts/flushDB.js --force",
    "build": "echo 'Backend ready'",
    "build:monolith": "npm --prefix ../frontend install && npm --prefix ../frontend run build",
    "build:frontend": "npm --prefix ../frontend run build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "mongoose": "^9.10.4",
    "node-cron": "^4.6.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0"
  }
}
